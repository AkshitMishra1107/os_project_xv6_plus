diff --git a/kernel/sysproc.c b/kernel/sysproc.c
index e303a35..ec2e01e 100644
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -5,6 +5,7 @@
 #include "memlayout.h"
 #include "spinlock.h"
 #include "proc.h"
+#include "memstat.h"
 
 uint64
 sys_exit(void)
@@ -102,3 +103,18 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+uint64
+sys_memstat(void)
+{
+  uint64 addr;
+  struct memstat ms;
+
+  argaddr(0, &addr);
+  memstat_fill(&ms);
+
+  if(copyout(myproc()->pagetable, addr,
+             (char*)&ms, sizeof(ms)) < 0)
+    return -1;
+
+  return 0;
+}
diff --git a/user/memstat.c b/user/memstat.c
new file mode 100644
index 0000000..776ab3c
--- /dev/null
+++ b/user/memstat.c
@@ -0,0 +1,24 @@
+#include "kernel/types.h"
+#include "user/user.h"
+#include "kernel/memstat.h"
+
+int
+main(void)
+{
+  struct memstat ms;
+
+  if(memstat(&ms) < 0){
+    printf("memstat: failed\n");
+    exit(1);
+  }
+
+  printf("page faults      %d\n", (int)ms.page_faults);
+  printf("lazy allocations %d\n", (int)ms.lazy_allocs);
+  printf("cow copies       %d\n", (int)ms.cow_copies);
+  printf("swap outs        %d\n", (int)ms.swap_outs);
+  printf("swap ins         %d\n", (int)ms.swap_ins);
+  printf("free pages       %d\n", (int)ms.free_pages);
+  printf("swap slots used  %d\n", (int)ms.swap_slots_used);
+
+  exit(0);
+}
