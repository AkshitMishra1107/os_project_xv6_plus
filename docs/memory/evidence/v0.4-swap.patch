diff --git a/user/hotcold.c b/user/hotcold.c
new file mode 100644
index 0000000..2e07d4c
--- /dev/null
+++ b/user/hotcold.c
@@ -0,0 +1,57 @@
+#include "kernel/types.h"
+#include "user/user.h"
+#include "kernel/memstat.h"
+
+#define PAGE 4096
+
+int
+main(void)
+{
+  int mb = 12;
+  int hot = 512;
+  int npages = mb * 256;
+
+  volatile char *base = sbrk(mb * 1024 * 1024);
+
+  if(base == (char *)-1){
+    printf("hotcold: sbrk failed\n");
+    exit(1);
+  }
+
+  printf("hotcold: 12 MB, 3 rounds\n");
+
+  // Initialize every page.
+  for(int i = 0; i < npages; i++)
+    base[i * PAGE] = 1;
+
+  struct memstat before, after;
+
+  if(memstat(&before) < 0){
+    printf("hotcold: initial memstat failed\n");
+    exit(1);
+  }
+
+  for(int round = 0; round < 3; round++){
+    for(int i = hot; i < npages; i++){
+      // Stream through cold pages.
+      base[i * PAGE] += 1;
+
+      // Revisit selected pages in the hot region.
+      if(i % 20 == 0){
+        for(int h = 0; h < hot; h += 8)
+          base[h * PAGE] += 1;
+      }
+    }
+  }
+
+  if(memstat(&after) < 0){
+    printf("hotcold: final memstat failed\n");
+    exit(1);
+  }
+
+  printf("hotcold: swap ins %d, swap outs %d\n",
+         (int)(after.swap_ins - before.swap_ins),
+         (int)(after.swap_outs - before.swap_outs));
+
+  exit(0);
+}
diff --git a/user/memhog.c b/user/memhog.c
new file mode 100644
index 0000000..4de8527
--- /dev/null
+++ b/user/memhog.c
@@ -0,0 +1,80 @@
+#include "kernel/types.h"
+#include "user/user.h"
+#include "kernel/memstat.h"
+
+#define PAGE 4096
+
+static void
+run_workload(int mb)
+{
+  int npages = mb * 256;
+  char *base = sbrk(mb * 1024 * 1024);
+
+  if(base == (char*)-1){
+    printf("memhog: sbrk failed\n");
+    exit(1);
+  }
+
+  for(int i = 0; i < npages; i++){
+    base[i * PAGE] = i % 251;
+    base[i * PAGE + PAGE - 1] = i % 241;
+  }
+
+  int bad = 0;
+
+  for(int i = 0; i < npages; i++){
+    if(base[i * PAGE] != (char)(i % 251) ||
+       base[i * PAGE + PAGE - 1] != (char)(i % 241))
+      bad++;
+  }
+
+  struct memstat ms;
+
+  if(memstat(&ms) < 0){
+    printf("memhog: memstat failed\n");
+    exit(1);
+  }
+
+  printf("memhog: %d MB, %d pages, %d bad, "
+         "swap outs %d, swap ins %d\n",
+         mb, npages, bad,
+         (int)ms.swap_outs, (int)ms.swap_ins);
+
+  exit(bad ? 1 : 0);
+}
+
+int
+main(int argc, char *argv[])
+{
+  int mb = 12;
+
+  if(argc > 1)
+    mb = atoi(argv[1]);
+
+  if(mb < 1){
+    printf("usage: memhog [positive MB]\n");
+    exit(1);
+  }
+
+  printf("memhog: starting %d MB workload\n", mb);
+
+  int pid = fork();
+
+  if(pid < 0){
+    printf("memhog: fork failed\n");
+    exit(1);
+  }
+
+  if(pid == 0)
+    run_workload(mb);
+
+  int status = -2;
+
+  if(wait(&status) < 0){
+    printf("memhog: wait failed\n");
+    exit(1);
+  }
+
+  printf("memhog: child exit status %d\n", status);
+  exit(status == 0 ? 0 : 1);
+}
diff --git a/user/swapfork.c b/user/swapfork.c
new file mode 100644
index 0000000..1e0bbdf
--- /dev/null
+++ b/user/swapfork.c
@@ -0,0 +1,75 @@
+#include "kernel/types.h"
+#include "user/user.h"
+
+#define PAGE 4096
+
+int
+main(void)
+{
+  int mb = 6;
+  int npages = mb * 256;
+
+  char *base = sbrk(mb * 1024 * 1024);
+
+  if(base == (char *)-1){
+    printf("swapfork: sbrk failed\n");
+    exit(1);
+  }
+
+  // Fill the parent's pages before sharing them.
+  for(int i = 0; i < npages; i++)
+    base[i * PAGE] = (char)(i % 251);
+
+  int pid = fork();
+
+  if(pid < 0){
+    printf("swapfork: fork failed\n");
+    exit(1);
+  }
+
+  if(pid == 0){
+    int bad = 0;
+
+    // Check the inherited data.
+    for(int i = 0; i < npages; i++){
+      if(base[i * PAGE] != (char)(i % 251))
+        bad++;
+    }
+
+    // Private writes force COW copies under memory pressure.
+    for(int i = 0; i < npages; i++)
+      base[i * PAGE + 1] = 77;
+
+    // Check both original data and private changes.
+    for(int i = 0; i < npages; i++){
+      if(base[i * PAGE] != (char)(i % 251) ||
+         base[i * PAGE + 1] != 77)
+        bad++;
+    }
+
+    printf("swapfork: child bad=%d\n", bad);
+    exit(bad ? 1 : 0);
+  }
+
+  int status = -2;
+
+  if(wait(&status) < 0){
+    printf("swapfork: wait failed\n");
+    exit(1);
+  }
+
+  int bad = (status != 0);
+
+  if(status != 0)
+    printf("swapfork: child exit status %d\n", status);
+
+  // The parent's data must remain unchanged.
+  for(int i = 0; i < npages; i++){
+    if(base[i * PAGE] != (char)(i % 251) ||
+       base[i * PAGE + 1] != 0)
+      bad++;
+  }
+
+  printf("swapfork: %s\n", bad ? "FAIL" : "OK");
+  exit(bad ? 1 : 0);
+}
