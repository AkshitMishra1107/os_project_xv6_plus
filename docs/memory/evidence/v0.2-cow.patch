+  for(; p + PGSIZE <= (char*)pa_end; p += PGSIZE){
+    // kfree will drop this initial reference to zero.
+    pgref.count[PGIDX(p)] = 1;
     kfree(p);
+  }
 }
 
-// Free the page of physical memory pointed at by pa,
-// which normally should have been returned by a
-// call to kalloc().  (The exception is when
-// initializing the allocator; see kinit above.)
 void
 kfree(void *pa)
 {
   struct run *r;
 
-  if(((uint64)pa % PGSIZE) != 0 || (char*)pa < end || (uint64)pa >= PHYSTOP)
+  if(((uint64)pa % PGSIZE) != 0 ||
+     (char*)pa < end ||
+     (uint64)pa >= PHYSTOP)
     panic("kfree");
 
-  // Fill with junk to catch dangling refs.
-  memset(pa, 1, PGSIZE);
+  acquire(&pgref.lock);
 
+  if(pgref.count[PGIDX(pa)] < 1)
+    panic("kfree: refcount");
+
+  if(--pgref.count[PGIDX(pa)] > 0){
+    release(&pgref.lock);
+    return;
+  }
+
+  release(&pgref.lock);
+
+  // Nobody owns this page now.
+  memset(pa, 1, PGSIZE);
   r = (struct run*)pa;
 
   acquire(&kmem.lock);
   r->next = kmem.freelist;
   kmem.freelist = r;
+  kmem.nfree++;
   release(&kmem.lock);
 }
 
-// Allocate one 4096-byte page of physical memory.
-// Returns a pointer that the kernel can use.
-// Returns 0 if the memory cannot be allocated.
 void *
 kalloc(void)
 {
@@ -72,11 +89,53 @@ kalloc(void)
 
   acquire(&kmem.lock);
   r = kmem.freelist;
-  if(r)
+
+  if(r){
     kmem.freelist = r->next;
+    kmem.nfree--;
+  }
+
   release(&kmem.lock);
 
-  if(r)
-    memset((char*)r, 5, PGSIZE); // fill with junk
+  if(r){
+    memset((char*)r, 5, PGSIZE);
+
+    acquire(&pgref.lock);
+    pgref.count[PGIDX(r)] = 1;
+    release(&pgref.lock);
+  }
+
   return (void*)r;
 }
+
+void
+kref_inc(void *pa)
+{
+  acquire(&pgref.lock);
+  pgref.count[PGIDX(pa)]++;
+  release(&pgref.lock);
+}
+
+int
+kref_get(void *pa)
+{
+  int n;
+
+  acquire(&pgref.lock);
+  n = pgref.count[PGIDX(pa)];
+  release(&pgref.lock);
+
+  return n;
+}
+
+uint64
+kfreepages(void)
+{
+  uint64 n;
+
+  acquire(&kmem.lock);
+  n = kmem.nfree;
+  release(&kmem.lock);
+
+  return n;
+}
diff --git a/kernel/pgfault.c b/kernel/pgfault.c
index c0400a0..1648f30 100644
--- a/kernel/pgfault.c
+++ b/kernel/pgfault.c
@@ -6,7 +6,6 @@
 #include "proc.h"
 #include "defs.h"
 
-// Return 0 when the fault is fixed, or -1 for an invalid access.
 int
 handle_page_fault(struct proc *p, uint64 va, int is_write)
 {
@@ -17,22 +16,53 @@ handle_page_fault(struct proc *p, uint64 va, int is_write)
 
   pte_t *pte = walk(p->pagetable, va, 0);
 
-  // An existing mapping faulted because access was not permitted.
-  // This also protects the stack guard page.
-  if(pte != 0 && (*pte & PTE_V))
-    return -1;
+  // Case 1: first access to an untouched lazy page.
+  if(pte == 0 || (*pte & PTE_V) == 0){
+    char *mem = kalloc();
 
-  char *mem = kalloc();
-  if(mem == 0)
-    return -1;
+    if(mem == 0)
+      return -1;
 
-  memset(mem, 0, PGSIZE);
+    memset(mem, 0, PGSIZE);
 
-  if(mappages(p->pagetable, va, PGSIZE, (uint64)mem,
-              PTE_R | PTE_W | PTE_U) != 0){
-    kfree(mem);
-    return -1;
+    if(mappages(p->pagetable, va, PGSIZE, (uint64)mem,
+                PTE_R | PTE_W | PTE_U) != 0){
+      kfree(mem);
+      return -1;
+    }
+
+    return 0;
+  }
+
+  // Case 2: write to a copy-on-write page.
+  if(is_write && (*pte & PTE_COW)){
+    uint64 pa = PTE2PA(*pte);
+
+    if(kref_get((void*)pa) == 1){
+      // Already private: restore write permission.
+      *pte = (*pte & ~PTE_COW) | PTE_W;
+    } else {
+      char *mem = kalloc();
+
+      if(mem == 0)
+        return -1;
+
+      memmove(mem, (char*)pa, PGSIZE);
+
+      uint64 flags =
+        (*pte & (PTE_R | PTE_X | PTE_U)) | PTE_W | PTE_V;
+
+      // Replace this process's mapping with its private copy.
+      *pte = PA2PTE(mem) | flags;
+
+      // Release this process's reference to the old page.
+      kfree((void*)pa);
+    }
+
+    sfence_vma();
+    return 0;
   }
 
-  return 0;
+  // Invalid access or a write to a genuinely read-only page.
+  return -1;
 }
