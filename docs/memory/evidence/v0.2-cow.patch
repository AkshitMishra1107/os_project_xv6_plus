diff --git a/user/cowtest.c b/user/cowtest.c
new file mode 100644
index 0000000..63c7a18
--- /dev/null
+++ b/user/cowtest.c
@@ -0,0 +1,58 @@
+#include "kernel/types.h"
+#include "user/user.h"
+
+#define PAGE 4096
+
+int
+main(void)
+{
+  int mb = 80;
+  int npages = mb * 256;
+  char *base = sbrk(mb * 1024 * 1024);
+
+  if(base == (char*)-1){
+    printf("cowtest: sbrk failed\n");
+    exit(1);
+  }
+
+  // Make all 80 MB physically resident.
+  for(int i = 0; i < npages; i++)
+    base[i * PAGE] = i % 100;
+
+  int pid = fork();
+
+  if(pid < 0){
+    printf("cowtest: fork failed\n");
+    exit(1);
+  }
+
+  if(pid == 0){
+    for(int i = 0; i < npages; i++){
+      if(base[i * PAGE] != i % 100){
+        printf("cowtest: child sees wrong data\n");
+        exit(1);
+      }
+    }
+
+    for(int i = 0; i < npages; i += 1000)
+      base[i * PAGE] = 99;
+
+    exit(0);
+  }
+
+  int status;
+  if(wait(&status) < 0 || status != 0){
+    printf("cowtest: child failed\n");
+    exit(1);
+  }
+
+  for(int i = 0; i < npages; i++){
+    if(base[i * PAGE] != i % 100){
+      printf("cowtest: parent data changed\n");
+      exit(1);
+    }
+  }
+
+  printf("cowtest: OK\n");
+  exit(0);
+}
diff --git a/user/forkbench.c b/user/forkbench.c
new file mode 100644
index 0000000..8a5ae57
--- /dev/null
+++ b/user/forkbench.c
@@ -0,0 +1,45 @@
+#include "kernel/types.h"
+#include "user/user.h"
+
+#define PAGE 4096
+
+int
+main(void)
+{
+  int mb = 20;
+  int npages = mb * 256;
+  char *base = sbrk(mb * 1024 * 1024);
+
+  if(base == (char*)-1){
+    printf("forkbench: sbrk failed\n");
+    exit(1);
+  }
+
+  for(int i = 0; i < npages; i++)
+    base[i * PAGE] = 1;
+
+  int start = uptime();
+
+  for(int n = 0; n < 50; n++){
+    int pid = fork();
+
+    if(pid < 0){
+      printf("forkbench: fork failed\n");
+      exit(1);
+    }
+
+    if(pid == 0)
+      exit(0);
+
+    int status;
+    if(wait(&status) < 0 || status != 0){
+      printf("forkbench: child failed\n");
+      exit(1);
+    }
+  }
+
+  printf("forkbench: 50 forks of a %d MB process took %d ticks\n",
+         mb, uptime() - start);
+
+  exit(0);
+}
