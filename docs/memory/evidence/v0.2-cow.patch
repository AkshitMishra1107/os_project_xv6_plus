   struct run *next;
@@ -21,12 +16,22 @@ struct run {
 struct {
   struct spinlock lock;
   struct run *freelist;
+  uint64 nfree;
 } kmem;
 
+#define NPAGES    ((PHYSTOP - KERNBASE) / PGSIZE)
+#define PGIDX(pa) (((uint64)(pa) - KERNBASE) / PGSIZE)
+
+struct {
+  struct spinlock lock;
+  int count[NPAGES];
+} pgref;
+
 void
-kinit()
+kinit(void)
 {
   initlock(&kmem.lock, "kmem");
+  initlock(&pgref.lock, "pgref");
   freerange(end, (void*)PHYSTOP);
